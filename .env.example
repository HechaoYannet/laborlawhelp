# Public settings
NEXT_PUBLIC_APP_URL=http://localhost:5000
NEXT_PUBLIC_ENABLE_DEV_INSPECTOR=false

# Server runtime
HOSTNAME=localhost
PORT=5000
# DEPLOY_RUN_PORT=5001
# NEXT_DEV_ALLOWED_ORIGINS=localhost:5000,example.dev

# Compatibility (deprecated)
# COZE_PROJECT_ENV=DEV
# COZE_WORKSPACE_PATH=

# MCP gateway and router
# PKULAW_MCP_TOKEN=replace_with_real_token
# Windows can use npx.cmd, Linux/macOS can use npx
MCP_ROUTER_COMMAND=npx.cmd
MCP_ROUTER_ARGS=-y pkulaw-mcp-router@latest serve --config ./config/pkulaw-mcp-router.toml
# MCP_ROUTER_CWD=
MCP_REQUEST_TIMEOUT_MS=30000
MCP_REQUEST_RETRIES=1
# MCP_GATEWAY_API_KEY=replace_with_internal_key
# MCP_ALLOWED_ORIGINS=http://localhost:5000
